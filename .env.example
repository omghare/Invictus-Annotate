# Copy to .env and adjust. Every value is optional.

# Signing key for logins. Leave unset to have one generated and kept in data/.secret_key.
# SECRET_KEY=

# Port, and who can connect: 0.0.0.0 = the whole LAN, 127.0.0.1 = this computer only
PORT=8000
HOST=0.0.0.0

# Where things are stored (defaults are folders inside the project)
# INVICTUS_DATA_DIR=D:/invictus/data            # database, thumbnails, backups, logs
# INVICTUS_DATASET_DIR=D:/invictus/dataset      # exports, extracted video frames, cloud bundles
# INVICTUS_MODELS_DIR=D:/invictus/models        # trained / imported models
# INVICTUS_RUNS_DIR=D:/invictus/training_runs   # Ultralytics run folders
# INVICTUS_MODEL_CACHE=C:/invictus/model_cache  # downloaded base weights (yolo11n.pt …) — put it on a roomy drive

# Daily database backups to keep (in data/backups/)
# INVICTUS_BACKUP_KEEP=14

# Interactive API docs at /api/docs (off by default)
# INVICTUS_API_DOCS=1
